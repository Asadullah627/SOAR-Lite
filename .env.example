# SOAR Lite environment variables. Copy to env.sh / .env, fill in, and keep it out of version control.
# Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# ---- Backend -------------------------------------------------------------
SOAR_DB_PATH=backend/soar_lite.db
SOAR_ADMIN_USER=admin
# Required on first start (otherwise a one-time password is printed in the log)
SOAR_ADMIN_PASSWORD=
SESSION_TTL_HOURS=8

# 1 = replay simulation/sample_alerts.jsonl, 0 = tail the real Wazuh alerts file
WAZUH_SIMULATION=1
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
# 1 = process the whole alerts file on start, 0 = only new alerts
WAZUH_READ_FROM_START=0
POLL_INTERVAL_SECONDS=10

VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
TI_CACHE_HOURS=24
HTTP_TIMEOUT_SECONDS=5

# Shared secret between backend and agents. Required. Use the same value on every agent.
AGENT_TOKEN=
AGENT_PORT=5055
# Agents not seen for this many seconds are Offline
AGENT_OFFLINE_SECONDS=120

# Never block these (comma separated). Loopback is always protected.
SOAR_SAFELIST=10.0.0.1,10.0.0.10,10.0.0.20
# Backend address: never blocked, and kept reachable when a host is isolated (isolation is disabled without it)
SOAR_BACKEND_IP=10.0.0.10
SOAR_GATEWAY_IP=10.0.0.1

# Optional perimeter fallback (untested against a real pfSense)
PFSENSE_URL=
PFSENSE_API_KEY=
PFSENSE_ALIAS=SOAR_BLOCKLIST

# ---- Agent (Windows endpoint) --------------------------------------------
# AGENT_TOKEN=            same value as the backend
# SOAR_BACKEND_URL=http://10.0.0.10:8000
# SOAR_BACKEND_IP=10.0.0.10
# SOAR_GATEWAY_IP=10.0.0.1
# SOAR_AGENT_ID=001       must match the Wazuh agent ID
# SOAR_SAFELIST=10.0.0.1,10.0.0.10,10.0.0.20
# SOAR_EVIDENCE_DIR=C:\SOAR-Agent\evidence
# SOAR_HEARTBEAT_SECONDS=60
# SOAR_AGENT_DRY_RUN=0    1 = record commands without running them (testing only)
